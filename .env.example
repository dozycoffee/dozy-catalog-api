# 로컬 개발용 — docker compose(및 spring-boot-docker-compose)가 compose.yaml을 실행할 때
# 이 파일과 같은 위치의 .env를 자동으로 읽어 아래 변수를 채웁니다.
# 사용법: 이 파일을 .env로 복사하고 실제 값을 채우세요. .env는 .gitignore에 의해 커밋되지 않습니다.
POSTGRES_DB=dozy_catalog
POSTGRES_USER=dozy_catalog
POSTGRES_PASSWORD=change-me

# ---
# prod 프로파일(spring.profiles.active=prod)용 참고— 로컬에서는 사용하지 않습니다.
# 실제 배포 환경에서는 이 .env가 아니라 배포 인프라(예: k8s Secret, ECS task definition 등)의
# 환경 변수로 주입하세요.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=
